# Скопируйте в .env и заполните. Файл .env в git не попадает.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trans-pulse_api?sslmode=disable
# Не короче 32 символов. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_TTL=1h
HTTP_ADDR=:8080

# MongoDB (docker compose -f docker-compose.mongo.yml up -d). Пароль задайте свой, он же в MONGO_URI.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me
MONGO_URI=mongodb://root:change-me@localhost:27017/?authSource=admin
MONGO_DB=trans_pulse
