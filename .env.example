# Образец настроек. Настоящий файл .env создаётся командой `bash scripts/init_env.sh` (или `make init-env`)
# со случайными паролями и в git не попадает. Значения CHANGE_ME_* скрипт заменяет сам.

# --- Docker-стек (docker-compose.app.yml) ---
POSTGRES_PASSWORD=CHANGE_ME_PG
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO
JWT_SECRET=CHANGE_ME_JWT
JWT_TTL=1h
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN
# порты на вашей машине (поменяйте, если заняты)
API_PORT=8080
POSTGRES_HOST_PORT=55432
MONGO_HOST_PORT=57017

# --- Запуск с хоста без контейнера api (make api-run, go test с хоста) против тех же баз ---
DATABASE_URL=postgres://postgres:CHANGE_ME_PG@localhost:55432/trans-pulse_api?sslmode=disable
MONGO_URI=mongodb://root:CHANGE_ME_MONGO@localhost:57017/?authSource=admin
MONGO_DB=trans_pulse
HTTP_ADDR=:8080
